<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_box_1">
    <static>true</static>
    <link name="box_link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.166667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.166667</iyy>
          <iyz>0</iyz>
          <izz>0.166667</izz>
        </inertia>
      </inertial>

      <!-- Main grey box visual -->
      <visual name="box_visual">
        <geometry>
          <box>
            <size>1.0 1.0 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- ArUco marker on front face -->
      <visual name="aruco_marker_visual">
        <pose>0.505 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.001 0.6 0.6</size>
          </box>
        </geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>file:///home/cameron/robotics_2026/auto-nav-f2025/Testing_gazebo_ros2_bridge/ros_gz_project_template/ros_gz_example_description/models/aruco_box_1/materials/textures/marker_1.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="box_collision">
        <geometry>
          <box>
            <size>1.0 1.0 1.0</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>